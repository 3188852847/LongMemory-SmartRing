# 仅供复制参考；真实配置文件是 .env.doubao.local，不提交版本库。
# 在启动面板的豆包配置入口填写语音服务 API Key，普通文字模型 Key 不等同于语音权限。
# 官方说明：https://www.volcengine.com/docs/6561/2549778
DOUBAO_API_KEY=""
DOUBAO_SPEAKER="zh_female_vv_jupiter_bigtts"
DOUBAO_INSTRUCTIONS="你是一位友善的中文语音助手。请自然、简洁地回答。"
# 当前适配器固定支持以下模型与地址，不可替换成其他协议的 URL。
DOUBAO_MODEL="1.2.6.1"
DOUBAO_WS_URL="wss://openspeech.bytedance.com/api/v3/duplex/realtime/dialogue"
