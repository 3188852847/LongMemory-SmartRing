+struct RoundSkinConfig {
+    int api = 1;
+    std::string id = "rose-night-v1";
+    std::string manifest_sha256 = "a30a24b7de67b26b40812d6fd234b18723d8345b5ba8b230e1cdcc3dfb70f6f5";
+    int background = 0x171B26;
+    int foreground = 0xF7F4F8;
+    int muted = 0xCBD1DC;
+    int accent = 0xDF72A8;
+    int listening = 0x69D5FF;
+    int thinking = 0xF7C65A;
+    int happy = 0x7DE2B8;
+    int concerned = 0x8AA8FF;
+    int error = 0xF16C73;
+    int eye_width = 22;
+    int eye_height = 36;
+    int mouth_width = 38;
+};
+
+static bool IsRoundSkinId(const std::string& value) {
+    if (value.size() < 3 || value.size() > 40 ||
+        !std::isalnum(static_cast<unsigned char>(value.front()))) {
+        return false;
+    }
+    for (unsigned char ch : value) {
+        if (!(std::islower(ch) || std::isdigit(ch) || ch == '-')) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool IsLowerHexSha256(const std::string& value) {
+    if (value.size() != 64) {
+        return false;
+    }
+    for (unsigned char ch : value) {
+        if (!(std::isdigit(ch) || (ch >= 'a' && ch <= 'f'))) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool IsRoundSkinValid(const RoundSkinConfig& skin) {
+    auto color = [](int value) { return value >= 0 && value <= 0xFFFFFF; };
+    return skin.api == 1 && IsRoundSkinId(skin.id) && IsLowerHexSha256(skin.manifest_sha256) &&
+           color(skin.background) && color(skin.foreground) && color(skin.muted) &&
+           color(skin.accent) && color(skin.listening) && color(skin.thinking) &&
+           color(skin.happy) && color(skin.concerned) && color(skin.error) &&
+           skin.eye_width >= 12 && skin.eye_width <= 36 &&
+           skin.eye_height >= 18 && skin.eye_height <= 48 &&
+           skin.mouth_width >= 20 && skin.mouth_width <= 64;
+}
+
+static RoundSkinConfig LoadRoundSkin() {
+    RoundSkinConfig skin;
+    Settings settings("round_skin");
+    skin.api = settings.GetInt("api", 0);
+    skin.id = settings.GetString("skin_id");
+    skin.manifest_sha256 = settings.GetString("skin_sha");
+    skin.background = settings.GetInt("background", -1);
+    skin.foreground = settings.GetInt("foreground", -1);
+    skin.muted = settings.GetInt("muted", -1);
+    skin.accent = settings.GetInt("accent", -1);
+    skin.listening = settings.GetInt("listening", -1);
+    skin.thinking = settings.GetInt("thinking", -1);
+    skin.happy = settings.GetInt("happy", -1);
+    skin.concerned = settings.GetInt("concerned", -1);
+    skin.error = settings.GetInt("error", -1);
+    skin.eye_width = settings.GetInt("eye_width", -1);
+    skin.eye_height = settings.GetInt("eye_height", -1);
+    skin.mouth_width = settings.GetInt("mouth_width", -1);
+    if (!IsRoundSkinValid(skin)) {
+        ESP_LOGI(TAG, "No valid persisted round skin; using built-in fallback");
+        return RoundSkinConfig();
+    }
+    ESP_LOGI(TAG, "Loaded round skin %s", skin.id.c_str());
+    return skin;
+}
+
+static void SaveRoundSkin(const RoundSkinConfig& skin) {
+    if (!IsRoundSkinValid(skin)) {
+        throw std::invalid_argument("Invalid round skin");
+    }
+    Settings settings("round_skin", true);
+    settings.SetString("skin_id", skin.id);
+    settings.SetString("skin_sha", skin.manifest_sha256);
+    settings.SetInt("background", skin.background);
+    settings.SetInt("foreground", skin.foreground);
+    settings.SetInt("muted", skin.muted);
+    settings.SetInt("accent", skin.accent);
+    settings.SetInt("listening", skin.listening);
+    settings.SetInt("thinking", skin.thinking);
+    settings.SetInt("happy", skin.happy);
+    settings.SetInt("concerned", skin.concerned);
+    settings.SetInt("error", skin.error);
+    settings.SetInt("eye_width", skin.eye_width);
+    settings.SetInt("eye_height", skin.eye_height);
+    settings.SetInt("mouth_width", skin.mouth_width);
+    settings.SetInt("api", skin.api);
+}
