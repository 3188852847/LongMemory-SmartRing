+++ b/main/boards/viewe-smartring-plus/pet_touch.h
@@ -0,0 +1,36 @@
+#pragma once
+#include <cstdlib>
+
+// 360px screen, 240px centred character. Track a change in stroke direction
+// so a quick straight swipe does not register as rubbing.
+struct PetTouch {
+    int start_x = 0, start_y = 0, peak_x = 0, direction = 0;
+    bool tracking = false, eligible = false, rubbed = false;
+    void begin(int x, int y, bool idle) {
+        start_x = peak_x = x;
+        start_y = y;
+        direction = 0;
+        rubbed = false;
+        tracking = true;
+        eligible = idle && x >= 101 && x <= 255 && y >= 85 && y <= 213;
+    }
+    void move(int x, int y) {
+        if (!eligible) return;
+        if (x < 82 || x > 275 || y < 65 || y > 233) { eligible = false; return; }
+        if (!direction) {
+            if (std::abs(x - start_x) < 14) return;
+            direction = x > start_x ? 1 : -1;
+            peak_x = x;
+        } else if ((x - peak_x) * direction > 0) {
+            peak_x = x;
+        } else if ((peak_x - x) * direction >= 14) {
+            rubbed = true;
+        }
+    }
+    const char* finish() {
+        tracking = false;
+        if (!eligible) return nullptr;
+        if (rubbed) return "sleepy";
+        return start_y < 151 ? "happy" : "winking";
+    }
+};
