+    void InitializeRoundWallpaperTools() {
+        auto& mcp = McpServer::GetInstance();
+        mcp.AddUserOnlyTool("self.screen.get_round_wallpaper",
+            "Read the verified active wallpaper and rollback availability",
+            PropertyList(), [](const PropertyList&) -> ReturnValue {
+                return RoundWallpaperStore::GetInstance().GetStatus();
+            });
+
+        mcp.AddUserOnlyTool("self.screen.stage_round_wallpaper",
+            "Download a validated 360x360 GIF to the inactive wallpaper slot without activating it",
+            PropertyList({
+                Property("wallpaper_api", kPropertyTypeInteger, 1, 1),
+                Property("wallpaper_id", kPropertyTypeString),
+                Property("sha256", kPropertyTypeString),
+                Property("size_bytes", kPropertyTypeInteger, 1, 3 * 1024 * 1024 - 4096),
+                Property("url", kPropertyTypeString),
+            }), [](const PropertyList& properties) -> ReturnValue {
+                if (properties["wallpaper_api"].value<int>() != 1) {
+                    throw std::invalid_argument("Unsupported wallpaper API");
+                }
+                RoundWallpaperRecord record;
+                if (!RoundWallpaperStore::GetInstance().Stage(
+                        properties["url"].value<std::string>(),
+                        properties["wallpaper_id"].value<std::string>(),
+                        properties["sha256"].value<std::string>(),
+                        properties["size_bytes"].value<int>(), record)) {
+                    throw std::runtime_error("Wallpaper staging failed");
+                }
+                cJSON* json = cJSON_CreateObject();
+                cJSON_AddNumberToObject(json, "wallpaper_api", record.api);
+                cJSON_AddStringToObject(json, "slot", record.slot.c_str());
+                cJSON_AddStringToObject(json, "wallpaper_id", record.id.c_str());
+                cJSON_AddStringToObject(json, "sha256", record.sha256.c_str());
+                cJSON_AddNumberToObject(json, "size_bytes", record.size);
+                cJSON_AddStringToObject(json, "state", "staged_verified");
+                return json;
+            });
+
+        mcp.AddUserOnlyTool("self.screen.activate_round_wallpaper",
+            "Select an exactly verified staged wallpaper; a separate reboot applies it",
+            PropertyList({
+                Property("wallpaper_api", kPropertyTypeInteger, 1, 1),
+                Property("slot", kPropertyTypeString),
+                Property("wallpaper_id", kPropertyTypeString),
+                Property("sha256", kPropertyTypeString),
+                Property("size_bytes", kPropertyTypeInteger, 1, 3 * 1024 * 1024 - 4096),
+            }), [](const PropertyList& properties) -> ReturnValue {
+                if (properties["wallpaper_api"].value<int>() != 1) {
+                    throw std::invalid_argument("Unsupported wallpaper API");
+                }
+                RoundWallpaperRecord record;
+                if (!RoundWallpaperStore::GetInstance().Activate(
+                        properties["slot"].value<std::string>(),
+                        properties["wallpaper_id"].value<std::string>(),
+                        properties["sha256"].value<std::string>(),
+                        properties["size_bytes"].value<int>(), record)) {
+                    throw std::runtime_error("Wallpaper activation failed");
+                }
+                cJSON* json = cJSON_CreateObject();
+                cJSON_AddNumberToObject(json, "wallpaper_api", record.api);
+                cJSON_AddStringToObject(json, "slot", record.slot.c_str());
+                cJSON_AddStringToObject(json, "wallpaper_id", record.id.c_str());
+                cJSON_AddStringToObject(json, "sha256", record.sha256.c_str());
+                cJSON_AddNumberToObject(json, "size_bytes", record.size);
+                cJSON_AddStringToObject(json, "state", "activation_pending_restart");
+                return json;
+            });
+
+        mcp.AddUserOnlyTool("self.screen.rollback_round_wallpaper",
+            "Select the previously active verified wallpaper; a separate reboot applies it",
+            PropertyList({Property("wallpaper_api", kPropertyTypeInteger, 1, 1)}),
+            [](const PropertyList& properties) -> ReturnValue {
+                if (properties["wallpaper_api"].value<int>() != 1) {
+                    throw std::invalid_argument("Unsupported wallpaper API");
+                }
+                RoundWallpaperRecord record;
+                if (!RoundWallpaperStore::GetInstance().Rollback(record)) {
+                    throw std::runtime_error("Wallpaper rollback failed");
+                }
+                cJSON* json = cJSON_CreateObject();
+                cJSON_AddNumberToObject(json, "wallpaper_api", record.api);
+                cJSON_AddStringToObject(json, "slot", record.slot.c_str());
+                cJSON_AddStringToObject(json, "wallpaper_id", record.id.c_str());
+                cJSON_AddStringToObject(json, "sha256", record.sha256.c_str());
+                cJSON_AddNumberToObject(json, "size_bytes", record.size);
+                cJSON_AddStringToObject(json, "state", "rollback_pending_restart");
+                return json;
+            });
+    }
