+void AudioService::SetManagedOutput(bool enabled) {
+    std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+    managed_output_ = enabled;
+}
+
+void AudioService::SetOutputChannel(uint64_t generation) {
+    {
+        std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+        output_channel_generation_ = generation;
+        // legacy WebSocket也保留不可变来源；本地提示音(0)不属于旧连接。
+        auto stale = [generation](const auto& task) { return task->channel_generation && task->channel_generation != generation; };
+        audio_decode_queue_.erase(std::remove_if(audio_decode_queue_.begin(), audio_decode_queue_.end(), stale), audio_decode_queue_.end());
+        audio_playback_queue_.erase(std::remove_if(audio_playback_queue_.begin(), audio_playback_queue_.end(), stale), audio_playback_queue_.end());
+        audio_queue_cv_.notify_all();
+    }
+    ResetCodecForOutput();
+}
+
+bool AudioService::IsManagedOutput() {
+    std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+    return managed_output_;
+}
+
+bool AudioService::MatchesOutputLocked(const AudioOutputIdentity& identity) const {
+    return identity.tagged() && managed_current_ && managed_current_->valid &&
+           managed_current_->identity == identity;
+}
+
+bool AudioService::IsCurrentOutput(const AudioOutputIdentity& identity) {
+    std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+    return MatchesOutputLocked(identity);
+}
+
+AudioOutputIdentity AudioService::OutputFenceIdentity() {
+    std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+    return output_fence_identity_;
+}
+
+void AudioService::RevokeOutputLocked(const std::shared_ptr<ManagedOutput>& output) {
+    if (!output || !output->valid) return;
+    output->valid = output->accepting = output->eos_pending = false;
+    if (audio_generation_counter_ == UINT64_MAX) output_fence_identity_ = {};
+    else output_fence_identity_ = {output->identity.channel_generation, output->identity.output_epoch, ++audio_generation_counter_};
+    const auto id = output->identity;
+    auto packets = [&id](const auto& packet) { return packet->output_identity == id; };
+    audio_decode_queue_.erase(std::remove_if(audio_decode_queue_.begin(), audio_decode_queue_.end(), packets), audio_decode_queue_.end());
+    audio_testing_queue_.erase(std::remove_if(audio_testing_queue_.begin(), audio_testing_queue_.end(), packets), audio_testing_queue_.end());
+    audio_playback_queue_.erase(std::remove_if(audio_playback_queue_.begin(), audio_playback_queue_.end(),
+        [&id](const auto& task) { return task->output_identity == id; }), audio_playback_queue_.end());
+    audio_queue_cv_.notify_all();
+}
+
+void AudioService::ResetCodecForOutput() {
+    // 不持queue mutex等待codec/output；已出队任务也在各自屏障内重核身份。
+    { std::lock_guard<std::mutex> lock(decoder_mutex_); if (opus_decoder_) esp_opus_dec_reset(opus_decoder_); decoder_sample_rate_ = 0; }
+    { std::lock_guard<std::mutex> lock(output_start_mutex_); }
+    // 到这里旧OutputData已返回，不宣称硬件DMA或扬声器残留已归零。
+}
+
+AudioOutputIdentity AudioService::BeginOutput(uint64_t channel_generation, uint32_t epoch) {
+    {
+        std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+        if (!managed_output_ || !channel_generation || !epoch || epoch > INT32_MAX ||
+            audio_generation_counter_ == UINT64_MAX) return {};
+        RevokeOutputLocked(managed_current_);
+    }
+    ResetCodecForOutput();
+    std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+    if (!managed_output_ || audio_generation_counter_ == UINT64_MAX) return {};
+    auto output = std::make_shared<ManagedOutput>();
+    output->identity = {channel_generation, epoch, ++audio_generation_counter_};
+    managed_current_ = output;
+    output_fence_identity_ = output->identity;
+    return output->identity;
+}
+
+bool AudioService::InterruptOutput(const AudioOutputIdentity& identity) {
+    {
+        std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+        if (!MatchesOutputLocked(identity)) return false;
+        RevokeOutputLocked(managed_current_);
+    }
+    ResetCodecForOutput();
+    return true;
+}
+
+void AudioService::InvalidateOutputChannel(uint64_t channel_generation) {
+    AudioOutputIdentity id;
+    { std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+      if (managed_current_ && managed_current_->identity.channel_generation == channel_generation)
+          id = managed_current_->identity; }
+    if (id.tagged()) InterruptOutput(id);
+}
+
+bool AudioService::OutputDrainedLocked(const std::shared_ptr<ManagedOutput>& output) {
+    if (!output || !output->valid || output != managed_current_ || !output->eos_pending ||
+        output->active_decode || output->active_output) return false;
+    const auto id = output->identity;
+    for (const auto& packet : audio_decode_queue_) if (packet->output_identity == id) return false;
+    for (const auto& task : audio_playback_queue_) if (task->output_identity == id) return false;
+    output->eos_pending = false;
+    return true;
+}
+
+bool AudioService::EndOutput(const AudioOutputIdentity& identity) {
+    bool drained = false;
+    {
+        std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+        if (!MatchesOutputLocked(identity) || !managed_current_->accepting) return false;
+        managed_current_->accepting = false;
+        managed_current_->eos_pending = true;
+        drained = OutputDrainedLocked(managed_current_);
+        audio_queue_cv_.notify_all();
+    }
+    if (drained && callbacks_.on_output_drained) callbacks_.on_output_drained(identity);
+    return true;
 }
 
