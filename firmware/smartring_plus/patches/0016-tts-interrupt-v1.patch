+void Application::HandleManagedTts(const cJSON* root) {
+    // cJSON bool并非number；仍显式拒绝非有限数、小数、零和越界值。
+    auto epoch_json = cJSON_GetObjectItem(root, "output_epoch");
+    auto state = cJSON_GetObjectItem(root, "state");
+    if (!cJSON_IsString(state) || !cJSON_IsNumber(epoch_json) || !std::isfinite(epoch_json->valuedouble) ||
+        epoch_json->valuedouble < 1 || epoch_json->valuedouble > INT32_MAX ||
+        std::floor(epoch_json->valuedouble) != epoch_json->valuedouble) return;
+    uint32_t epoch = static_cast<uint32_t>(epoch_json->valuedouble);
+    if (strcmp(state->valuestring, "start") == 0) {
+        if (epoch <= tts_last_epoch_) return; // 重复start不能复活被撤权的同一轮。
+        auto identity = audio_service_.BeginOutput(tts_channel_generation_, epoch);
+        if (!identity.tagged()) {
+            CloseOutputChannelSoon();
+            return;
+        }
+        tts_last_epoch_ = epoch;
+        tts_output_identity_ = identity;
+        tts_accepting_ = true;
+        tts_revoked_ = false;
+        tts_ui_pending_ = true;
+        ScheduleOnOutput(identity, [this]() {
+            tts_ui_pending_ = false;
+            aborted_ = false;
+            SetDeviceState(kDeviceStateSpeaking);
+        });
+        return;
+    }
+    if (epoch != tts_last_epoch_ || tts_revoked_ || !audio_service_.IsCurrentOutput(tts_output_identity_)) return;
+    if (strcmp(state->valuestring, "sentence_start") == 0) {
+        auto text = cJSON_GetObjectItem(root, "text");
+        if (tts_accepting_ && cJSON_IsString(text)) {
+            ScheduleOnOutput(tts_output_identity_, [message = std::string(text->valuestring)]() {
+                Board::GetInstance().GetDisplay()->SetChatMessage("assistant", message.c_str());
+            });
+        }
+    } else if (strcmp(state->valuestring, "stop") == 0) {
+        tts_accepting_ = false;
+        audio_service_.EndOutput(tts_output_identity_); // EOS保持代次，活动decode/output也必须排空。
+    } else if (strcmp(state->valuestring, "interrupt") == 0) {
+        if (!audio_service_.InterruptOutput(tts_output_identity_)) return;
+        tts_output_identity_ = audio_service_.OutputFenceIdentity();
+        if (!tts_output_identity_.tagged()) { CloseOutputChannelSoon(); return; }
+        tts_accepting_ = false;
+        tts_revoked_ = tts_ui_pending_ = true;
+        ScheduleOnOutput(tts_output_identity_, [this]() {
+            tts_ui_pending_ = false;
+            show_interrupted_on_listening_ = true;
+            ApplyOutputStopped();
+        }, true);
+    }
+}
