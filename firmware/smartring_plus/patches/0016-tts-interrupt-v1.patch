+// 接收路径先同步提交音频门；UI任务仅应用捕获身份，不能重新标记旧工作。
+void Application::OnLocalChannelOpening(uint64_t generation) {
+    std::lock_guard<std::recursive_mutex> lock(tts_output_mutex_);
+    audio_service_.InvalidateOutputChannel(tts_channel_generation_);
+    audio_service_.SetOutputChannel(generation);
+    audio_service_.SetManagedOutput(false);
+    tts_channel_generation_ = generation;
+    tts_last_epoch_ = 0;
+    tts_hello_seen_ = tts_interrupt_v1_ = tts_accepting_ = tts_revoked_ = tts_ui_pending_ = false;
+    tts_output_identity_ = {};
+}
+
+void Application::OnLocalChannelOpened(uint64_t generation) {
+    std::lock_guard<std::recursive_mutex> lock(tts_output_mutex_);
+    if (generation != tts_channel_generation_) return;
+    auto& board = Board::GetInstance();
+    board.SetPowerSaveLevel(PowerSaveLevel::PERFORMANCE);
+    if (protocol_->server_sample_rate() != board.GetAudioCodec()->output_sample_rate())
+        ESP_LOGW(TAG, "Server sample rate differs from codec output; resampling enabled");
+}
+
+void Application::OnLocalChannelClosed(uint64_t generation) {
+    std::lock_guard<std::recursive_mutex> lock(tts_output_mutex_);
+    if (generation != tts_channel_generation_) return;
+    audio_service_.InvalidateOutputChannel(generation);
+    audio_service_.SetOutputChannel(0);
+    audio_service_.SetManagedOutput(false);
+    tts_channel_generation_ = 0;
+    tts_closed_generation_ = generation;
+    tts_hello_seen_ = tts_interrupt_v1_ = tts_accepting_ = tts_revoked_ = tts_ui_pending_ = false;
+    tts_output_identity_ = {};
+    Board::GetInstance().SetPowerSaveLevel(PowerSaveLevel::LOW_POWER);
+    Schedule([this, generation]() {
+        std::lock_guard<std::recursive_mutex> lock(tts_output_mutex_);
+        if (tts_channel_generation_ || tts_closed_generation_ != generation) return;
+        Board::GetInstance().GetDisplay()->SetChatMessage("system", "");
+        SetDeviceState(kDeviceStateIdle);
+    });
+}
+
+void Application::OnLocalChannelJson(uint64_t generation, const cJSON* root) {
+    std::lock_guard<std::recursive_mutex> lock(tts_output_mutex_);
+    if (generation != tts_channel_generation_) return;
+    auto type = cJSON_GetObjectItem(root, "type");
+    if (!cJSON_IsString(type)) return;
+    if (strcmp(type->valuestring, "hello") == 0) {
+        if (tts_hello_seen_) return;
+        tts_hello_seen_ = true;
+#if CONFIG_BOARD_TYPE_VIEWE_SMARTRING_PLUS
+        // 仅本板客户端声明能力，且服务器返回严格布尔true时启用。
+        auto features = cJSON_GetObjectItem(root, "features");
+        tts_interrupt_v1_ = cJSON_IsObject(features) && cJSON_IsTrue(cJSON_GetObjectItem(features, "tts_interrupt_v1"));
+#endif
+        audio_service_.SetManagedOutput(tts_interrupt_v1_);
+        return;
+    }
+    if (!tts_hello_seen_) return;
+    HandleProtocolJson(generation, root);
+}
+
+void Application::ScheduleOnChannel(uint64_t generation, std::function<void()>&& callback) {
+    Schedule([this, generation, callback = std::move(callback)]() {
+        std::lock_guard<std::recursive_mutex> lock(tts_output_mutex_);
+        if (generation && generation != tts_channel_generation_) return;
+        callback();
+    });
+}
+
+void Application::ScheduleOnOutput(const AudioOutputIdentity& identity, std::function<void()>&& callback, bool revoked) {
+    Schedule([this, identity, revoked, callback = std::move(callback)]() {
+        std::lock_guard<std::recursive_mutex> lock(tts_output_mutex_);
+        if (!tts_interrupt_v1_ || identity.channel_generation != tts_channel_generation_ || identity != tts_output_identity_) return;
+        if (revoked ? (!tts_revoked_ || audio_service_.OutputFenceIdentity() != identity) :
+                      (tts_revoked_ || !audio_service_.IsCurrentOutput(identity))) return;
+        callback(); // 核对与状态/显示副作用共用同一屏障。
+    });
+}
+
+void Application::ApplyOutputStopped() {
+    SetDeviceState(listening_mode_ == kListeningModeManualStop ? kDeviceStateIdle : kDeviceStateListening);
+}
+
+void Application::OnOutputDrained(const AudioOutputIdentity& identity) {
+    ScheduleOnOutput(identity, [this]() {
+        tts_ui_pending_ = false;
+        ApplyOutputStopped();
+    });
+}
+
+void Application::CloseOutputChannelSoon() {
+    tts_accepting_ = false;
+    const auto channel = tts_channel_generation_;
+    Schedule([this, channel]() {
+        { std::lock_guard<std::recursive_mutex> lock(tts_output_mutex_);
+          if (channel != tts_channel_generation_) return; }
+        // 不持应用屏障join socket；main loop中的创建/关闭按任务顺序执行。
+        protocol_->CloseAudioChannel();
+    });
+}
