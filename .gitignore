# Python 与测试缓存
__pycache__/
*.py[cod]
.pytest_cache/
# 历史测试目录与研究证据继续忽略；新 pytest 自动产物使用 data/test-tmp/pytest/。
.pytest-tmp/
.test-runtime/
.tmp-tests/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 虚拟环境与本地工具
.venv/
.uv-cache/
*.egg-info/
.idea/
.vscode/

# 密钥与本地配置
.env
.env.*
!.env.example
!.env.doubao.example

# LongMemory 运行数据：目录保留，真实内容不提交
data/control/
data/databases/*
!data/databases/.gitkeep
# 本次正式Hy SDK/Chroma及管理scope/审计是私有持久状态，不能进入Git。
/data/memory/hy-daily-20261019/
/data/memory/hy-campus-daily-20261019/
data/logs/*
!data/logs/.gitkeep
data/exports/*
!data/exports/.gitkeep
data/backups/*
!data/backups/.gitkeep
data/audio/*
!data/audio/.gitkeep
# 测试夹具和临时输出（含每进程唯一的 pytest/run-*），不保存研究证据。
data/test-tmp/
# 本机目录整理时保留的历史测试产物；只归档，不进入版本库。
data/local-archive/

# 实验运行产物
experiments/jobs/
data/models/
experiments/runs/*
!experiments/runs/.gitkeep
experiments/results/*
!experiments/results/.gitkeep

# 嵌入式构建产物和本地配置
firmware/**/build/
firmware/**/managed_components/
firmware/**/sdkconfig
firmware/**/sdkconfig.old

# 常见临时文件
web/react-chat/node_modules/
web/react-chat/dist/
web/react-chat/playwright-report/
web/react-chat/test-results/
.pnpm-store/
*.log
*.tmp
*.bak
Thumbs.db
.DS_Store
# 用户上传的圆屏原片、缩略图与派生资源只保存在本机，不进入版本库。
data/round-screen/

# 旧根备份路径继续防误提交；当前私有配置/档案/外部资源位于 local/。
/LongMemory备份/
/local/
