# Python 与测试缓存
__pycache__/
*.py[cod]
.pytest_cache/
.pytest-tmp/
.test-runtime/
.tmp-tests/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 虚拟环境与本地工具
.venv/
.uv-cache/
*.egg-info/
.idea/
.vscode/

# 密钥与本地配置
.env
.env.*
!.env.example
!.env.doubao.example

# LongMemory 运行数据：目录保留，真实内容不提交
data/control/
data/databases/*
!data/databases/.gitkeep
data/logs/*
!data/logs/.gitkeep
data/exports/*
!data/exports/.gitkeep
data/backups/*
!data/backups/.gitkeep
data/audio/*
!data/audio/.gitkeep
data/test-tmp/
# 本机目录整理时保留的历史测试产物；只归档，不进入版本库。
data/local-archive/

# 实验运行产物
experiments/jobs/
data/models/
experiments/runs/*
!experiments/runs/.gitkeep
experiments/results/*
!experiments/results/.gitkeep

# 嵌入式构建产物和本地配置
firmware/**/build/
firmware/**/managed_components/
firmware/**/sdkconfig
firmware/**/sdkconfig.old

# 常见临时文件
web/react-chat/node_modules/
web/react-chat/dist/
web/react-chat/playwright-report/
web/react-chat/test-results/
.pnpm-store/
*.log
*.tmp
*.bak
Thumbs.db
.DS_Store
# 用户上传的圆屏原片、缩略图与派生资源只保存在本机，不进入版本库。
data/round-screen/

# 重装私有备份与本项目专用的外部运行资源。
/LongMemory备份/
/local/
