{
  "schema_version": 2,
  "dataset_id": "l2-retrieval-v2",
  "description": "L2 场景召回开发与冻结留出数据；全部为合成内容，不含个人数据。",
  "scenarios": [
    {"id": "defense", "title": "准备毕业设计答辩", "summary": "用户周五下午进行毕业设计汇报，这几天晚上主要修改 PPT，并计划周四完成一次彩排。", "status": "active"},
    {"id": "advisor", "title": "与导师讨论实验", "summary": "用户周三下午与导师见面，需要整理召回实验结果和失败案例。", "status": "active"},
    {"id": "cat", "title": "照顾豆包", "summary": "用户养了一只叫豆包的猫，最近需要留意它的饮水和猫粮。", "status": "active"},
    {"id": "tea", "title": "日常饮品偏好", "summary": "用户平时喜欢乌龙茶，最近也会喝茉莉花茶，不喜欢太甜的饮料。", "status": "active"},
    {"id": "coffee_shop", "title": "周末去江南咖啡店", "summary": "用户周六偶尔去江南咖啡店，喜欢靠窗座位，通常点无糖拿铁。", "status": "active"},
    {"id": "sleep", "title": "近期睡眠安排", "summary": "用户工作日通常零点前休息，第二天早上七点半起床。", "status": "active"},
    {"id": "exercise", "title": "晚间运动习惯", "summary": "用户最近每周二和周四晚上跑步，雨天改为室内训练。", "status": "active"},
    {"id": "project", "title": "长程记忆项目开发", "summary": "用户正在开发智能圆屏长期记忆系统，目前关注记忆质量、语音交互和设备体验。", "status": "active"},
    {"id": "travel", "title": "国庆南京行程", "summary": "用户计划国庆假期坐高铁去南京，出发前要确认车票和住宿。", "status": "active"},
    {"id": "music", "title": "学习时的音乐偏好", "summary": "用户写报告时喜欢听轻柔纯音乐，不喜欢音量太大。", "status": "active"},
    {"id": "groceries", "title": "周日采购", "summary": "用户通常周日下午去超市，这次需要买燕麦奶和香蕉。", "status": "active"},
    {"id": "old_defense", "title": "上学期的开题汇报", "summary": "用户上学期周二上午参加了开题汇报，当时准备了十分钟发言。", "status": "expired"},
    {"id": "old_exercise", "title": "之前的游泳安排", "summary": "用户之前每周一晚上游泳，后来已经停止这个安排。", "status": "expired"}
  ],
  "cases": [
    {"id": "dev-direct-defense", "split": "dev", "category": "direct", "query": "我的答辩准备得怎么样了？", "expected_ids": ["defense"]},
    {"id": "dev-paraphrase-defense", "split": "dev", "category": "paraphrase", "query": "演示文稿和预演安排到哪一步了？", "expected_ids": ["defense"]},
    {"id": "dev-advisor-material", "split": "dev", "category": "relational", "query": "见导师前我要整理哪些实验材料？", "expected_ids": ["advisor"]},
    {"id": "dev-direct-cat", "split": "dev", "category": "direct", "query": "豆包最近需要注意什么？", "expected_ids": ["cat"]},
    {"id": "dev-paraphrase-cat", "split": "dev", "category": "paraphrase", "query": "我家宠物的饮食照顾有什么要留意的？", "expected_ids": ["cat"]},
    {"id": "dev-direct-tea", "split": "dev", "category": "direct", "query": "我平时喜欢喝什么茶？", "expected_ids": ["tea"]},
    {"id": "dev-coffee-seat", "split": "dev", "category": "relational", "query": "周六去咖啡店时我喜欢坐在哪里？", "expected_ids": ["coffee_shop"]},
    {"id": "dev-coffee-order", "split": "dev", "category": "paraphrase", "query": "我在江南那家店通常喝什么？", "expected_ids": ["coffee_shop"]},
    {"id": "dev-paraphrase-sleep", "split": "dev", "category": "paraphrase", "query": "我一般几点睡，早晨几点起来？", "expected_ids": ["sleep"]},
    {"id": "dev-abstract-sleep", "split": "dev", "category": "abstract_paraphrase", "query": "我工作日的昼夜节律怎样？", "expected_ids": ["sleep"]},
    {"id": "dev-conditional-exercise", "split": "dev", "category": "conditional", "query": "下雨时我还去外面跑步吗？", "expected_ids": ["exercise"]},
    {"id": "dev-project-focus", "split": "dev", "category": "multi_topic", "query": "我做的圆屏记忆系统目前关注哪些体验？", "expected_ids": ["project"]},
    {"id": "dev-travel-checklist", "split": "dev", "category": "relational", "query": "去南京前我要确认哪两件事？", "expected_ids": ["travel"]},
    {"id": "dev-music-volume", "split": "dev", "category": "conditional", "query": "写报告时给我放很响的歌合适吗？", "expected_ids": ["music"]},
    {"id": "dev-multi-week-plan", "split": "dev", "category": "multi_evidence", "query": "这周的答辩和导师见面各需要准备什么？", "expected_ids": ["defense", "advisor"]},
    {"id": "dev-unknown-cat-color", "split": "dev", "category": "unanswerable_near", "query": "豆包的毛是什么颜色？", "expected_ids": []},
    {"id": "dev-unknown-advisor-tea", "split": "dev", "category": "unanswerable_near", "query": "我的导师最喜欢喝什么茶？", "expected_ids": []},
    {"id": "dev-unknown-coffee-companion", "split": "dev", "category": "unanswerable_near", "query": "周六是谁陪我去江南咖啡店？", "expected_ids": []},
    {"id": "dev-unknown-cat-food-brand", "split": "dev", "category": "unanswerable_near", "query": "豆包吃的猫粮是什么品牌？", "expected_ids": []},
    {"id": "dev-expired-defense-time", "split": "dev", "category": "expired_only", "query": "我上学期的开题汇报是星期几上午？", "expected_ids": []},
    {"id": "dev-expired-swimming", "split": "dev", "category": "expired_only", "query": "我现在每周一还去游泳吗？", "expected_ids": []},
    {"id": "dev-unknown-lunch", "split": "dev", "category": "unanswerable_far", "query": "我今天午饭吃了什么？", "expected_ids": []},
    {"id": "dev-unknown-travel-hotel", "split": "dev", "category": "unanswerable_near", "query": "我去南京订的酒店叫什么？", "expected_ids": []},
    {"id": "dev-unknown-device-color", "split": "dev", "category": "unanswerable_near", "query": "我的智能圆屏外壳是什么颜色？", "expected_ids": []},

    {"id": "holdout-shopping-time", "split": "holdout", "category": "paraphrase", "query": "我通常什么时候补充日常用品？", "expected_ids": ["groceries"]},
    {"id": "holdout-shopping-list", "split": "holdout", "category": "relational", "query": "这次去超市记得帮我提醒哪两样东西？", "expected_ids": ["groceries"]},
    {"id": "holdout-tea-sweetness", "split": "holdout", "category": "conditional", "query": "给我推荐很甜的饮料合适吗？", "expected_ids": ["tea"]},
    {"id": "holdout-exercise-days", "split": "holdout", "category": "direct", "query": "我最近一周哪两天跑步？", "expected_ids": ["exercise"]},
    {"id": "holdout-project-description", "split": "holdout", "category": "abstract_paraphrase", "query": "我正在做的人机交互研究载体是什么？", "expected_ids": ["project"]},
    {"id": "holdout-advisor-when", "split": "holdout", "category": "direct", "query": "我什么时候和导师讨论实验？", "expected_ids": ["advisor"]},
    {"id": "holdout-travel-mode", "split": "holdout", "category": "paraphrase", "query": "国庆去南京打算用什么交通方式？", "expected_ids": ["travel"]},
    {"id": "holdout-coffee-full", "split": "holdout", "category": "multi_attribute", "query": "说说我周末喝咖啡的地方、座位和口味。", "expected_ids": ["coffee_shop"]},
    {"id": "holdout-multi-routine", "split": "holdout", "category": "multi_evidence", "query": "概括我的晚间休息和运动安排。", "expected_ids": ["sleep", "exercise"]},
    {"id": "holdout-unknown-cat-age", "split": "holdout", "category": "unanswerable_near", "query": "豆包今年几岁？", "expected_ids": []},
    {"id": "holdout-unknown-advisor-name", "split": "holdout", "category": "unanswerable_near", "query": "我的导师叫什么名字？", "expected_ids": []},
    {"id": "holdout-unknown-travel-date", "split": "holdout", "category": "unanswerable_near", "query": "去南京的高铁具体几号出发？", "expected_ids": []},
    {"id": "holdout-expired-speech-length", "split": "holdout", "category": "expired_only", "query": "上学期开题汇报准备了几分钟发言？", "expected_ids": []},
    {"id": "holdout-unknown-music-artist", "split": "holdout", "category": "unanswerable_near", "query": "我写报告时最喜欢哪位歌手？", "expected_ids": []}
