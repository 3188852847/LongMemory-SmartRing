@audio_types@
struct esp_audio_dec_in_raw_t { uint8_t* buffer; uint32_t len; int consumed; int frame_recover; };
struct esp_audio_dec_out_frame_t { uint8_t* buffer; uint32_t len; uint32_t decoded_size; };
struct esp_audio_dec_info_t {};
using esp_ae_sample_t = int16_t*;
int esp_opus_dec_reset(void*) { hook("reset"); return 0; }
int esp_opus_dec_decode(void*, esp_audio_dec_in_raw_t* raw, esp_audio_dec_out_frame_t* out, esp_audio_dec_info_t*) {
    hook("decode");
    if (raw->buffer[0]==255) return -1;
    if (raw->buffer[0]==254) throw std::runtime_error("injected decode failure");
    auto pcm=reinterpret_cast<int16_t*>(out->buffer);
    std::fill(pcm,pcm+out->len/sizeof(int16_t),raw->buffer[0]);out->decoded_size=out->len;return 0;
}
void esp_ae_rate_cvt_get_max_out_sample_num(void*, size_t n, uint32_t* out) { *out=static_cast<uint32_t>(n); }
void esp_ae_rate_cvt_process(void*, esp_ae_sample_t in, size_t n, esp_ae_sample_t out, uint32_t*) { std::copy(in,in+n,out); }
struct AudioCodec {
    std::mutex mutex; std::vector<int> played; std::vector<size_t> sizes;
    bool output_enabled() {return true;} void EnableOutput(bool) {}
    int output_sample_rate() {return 24000;}
    void OutputData(std::vector<int16_t>& pcm) { hook("output"); if(pcm.at(0)==254)throw std::runtime_error("injected output failure");std::lock_guard lock(mutex); played.push_back(pcm.at(0));sizes.push_back(pcm.size()); }
};
class AudioService {
public:
@audio_state@
    AudioCodec codec_value; AudioCodec* codec_=&codec_value;
    AudioServiceCallbacks callbacks_; std::mutex decoder_mutex_, audio_queue_mutex_;
    std::condition_variable audio_queue_cv_;
    std::deque<std::unique_ptr<AudioStreamPacket>> audio_decode_queue_,audio_testing_queue_;
    std::deque<std::unique_ptr<AudioTask>> audio_playback_queue_;
    std::deque<uint32_t> timestamp_queue_;
    std::atomic<bool> service_stopped_{false}; void* opus_decoder_=this; void* output_resampler_=nullptr;
    int decoder_sample_rate_=24000, decoder_frame_size_=4, audio_power_timer_=0;
    DebugStatistics debug_statistics_{}; std::chrono::steady_clock::time_point last_output_time_;
    void SetDecodeSampleRate(int sample_rate,int) {decoder_sample_rate_=sample_rate;}
    void SetManagedOutput(bool); bool IsManagedOutput(); bool IsCurrentOutput(const AudioOutputIdentity&);
    AudioOutputIdentity OutputFenceIdentity(); AudioOutputIdentity BeginOutput(uint64_t,uint32_t);
    void SetOutputChannel(uint64_t);
    bool InterruptOutput(const AudioOutputIdentity&); void InvalidateOutputChannel(uint64_t);
    bool EndOutput(const AudioOutputIdentity&); void ResetDecoder();
    bool PushPacketToDecodeQueue(std::unique_ptr<AudioStreamPacket>,bool wait=false);
    void AudioOutputTask(); void DecodeOne();
    bool processor=false; int voice_resets=0;
    void EnableVoiceProcessing(bool value) { if(value) {++voice_resets; ResetDecoder();} processor=value; }
    void EnableWakeWordDetection(bool) {} bool IsAfeWakeWord() {return false;}
    bool IsAudioProcessorRunning() {return processor;}
    void WaitForPlaybackQueueEmpty() {assert(false);}
    template<class T> void PlaySound(T) {}
    void Shutdown() { service_stopped_=true; audio_queue_cv_.notify_all(); }
    size_t Queued() {std::lock_guard lock(audio_queue_mutex_); return audio_decode_queue_.size()+audio_playback_queue_.size();}
};
