namespace Lang { namespace Strings {constexpr auto STANDBY="idle",CONNECTING="connecting",LISTENING="listening",SPEAKING="speaking";} namespace Sounds {constexpr auto OGG_POPUP="popup";} }
struct MockProtocol {
    int closed=0,aborts=0; int server_sample_rate() {return 24000;} void CloseAudioChannel() {++closed;}
    void SendStartListening(ListeningMode) {} void SendAbortSpeaking(AbortReason) {++aborts;}
};
class Application {
public:
    AudioService audio_service_; std::recursive_mutex tts_output_mutex_;
    uint64_t tts_channel_generation_=0,tts_closed_generation_=0; uint32_t tts_last_epoch_=0;
    bool tts_hello_seen_=false,tts_interrupt_v1_=false,tts_accepting_=false,tts_revoked_=false,tts_ui_pending_=false;
    AudioOutputIdentity tts_output_identity_;
    MockProtocol protocol_value; MockProtocol* protocol_=&protocol_value;
    bool aborted_=false,show_interrupted_on_listening_=false,play_popup_on_listening_=false;
    ListeningMode listening_mode_=kListeningModeAutoStop; int clock_ticks_=0;
    struct State {DeviceState state=kDeviceStateListening; DeviceState GetState() {return state;}} state_machine_;
    std::mutex tasks_mutex; std::deque<std::function<void()>> tasks;
    Application() {audio_service_.callbacks_.on_output_drained=[this](auto id){OnOutputDrained(id);};}
    DeviceState GetDeviceState() {return state_machine_.state;} void SetDeviceState(DeviceState state) {state_machine_.state=state;}
    void Schedule(std::function<void()>&& fn) {std::lock_guard lock(tasks_mutex);tasks.push_back(std::move(fn));}
    void Run() {for(;;) {std::function<void()> fn; {std::lock_guard lock(tasks_mutex); if(tasks.empty()) break; fn=std::move(tasks.front()); tasks.pop_front();} fn(); HandleStateChangedEvent();}}
    void OnLocalChannelOpening(uint64_t); void OnLocalChannelOpened(uint64_t); void OnLocalChannelClosed(uint64_t);
    void OnLocalChannelJson(uint64_t,const cJSON*); void HandleManagedTts(const cJSON*);
    void ScheduleOnChannel(uint64_t,std::function<void()>&&); void ScheduleOnOutput(const AudioOutputIdentity&,std::function<void()>&&,bool revoked=false);
    void ApplyOutputStopped(); void CloseOutputChannelSoon(); void OnOutputDrained(const AudioOutputIdentity&); void Receive(std::unique_ptr<AudioStreamPacket>);
    void HandleStateChangedEvent(); void AbortSpeaking(AbortReason);
    // Legacy parser remains compiled/verified by the real target build; this fixture
    // invokes only its v1 dispatch and models legacy tts start for negotiation tests.
    void HandleProtocolJson(uint64_t generation,const cJSON* root) {
        std::lock_guard lock(tts_output_mutex_); if(generation&&generation!=tts_channel_generation_)return;
        if(tts_interrupt_v1_) {HandleManagedTts(root);return;}
        auto state=cJSON_GetObjectItem(root,"state");
        if(cJSON_IsString(state)&&std::string(state->valuestring)=="start") ScheduleOnChannel(generation,[this]{SetDeviceState(kDeviceStateSpeaking);});
    }
    void Json(uint64_t channel,const char* text) {auto root=cJSON_Parse(text);assert(root);OnLocalChannelJson(channel,root);cJSON_Delete(root);}
};
