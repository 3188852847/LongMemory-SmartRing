std::unique_ptr<AudioStreamPacket> packet(AudioOutputIdentity id={},int value=7,uint64_t channel=0) {
    auto p=std::make_unique<AudioStreamPacket>();p->sample_rate=24000;p->frame_duration=60;p->output_identity=id;p->channel_generation=channel;p->payload={static_cast<uint8_t>(value)};return p;
}
void await_invalid(AudioService& audio, AudioOutputIdentity id) {
    auto deadline=std::chrono::steady_clock::now()+5s;
    while(audio.IsCurrentOutput(id)) {assert(std::chrono::steady_clock::now()<deadline);std::this_thread::yield();}
}
void eos_decode() {
    AudioService audio;audio.SetManagedOutput(true);auto id=audio.BeginOutput(1,1);std::atomic<int> eos=0;
    audio.callbacks_.on_output_drained=[&](auto value){assert(value==id);++eos;};
    Latch handoff,decode;hooks([&](const char* name){if(std::string(name)=="decode_handoff")handoff.pause();if(std::string(name)=="decode")decode.pause();});
    assert(audio.PushPacketToDecodeQueue(packet(id,9)));std::thread worker([&]{audio.DecodeOne();});handoff.wait();
    auto stop=std::async(std::launch::async,[&]{return audio.EndOutput(id);});assert(stop.wait_for(0ms)!=std::future_status::ready);
    handoff.release();decode.wait();assert(stop.wait_for(5s)==std::future_status::ready);assert(stop.get());
    assert(audio.Queued()==0);assert(eos==0);decode.release();worker.join();hooks();
    assert(eos==0&&audio.Queued()==1);std::thread output([&]{audio.AudioOutputTask();});
    {std::unique_lock lock(audio.audio_queue_mutex_);assert(audio.audio_queue_cv_.wait_for(lock,5s,[&]{return audio.managed_current_->active_output==0&&audio.audio_playback_queue_.empty();}));}
    audio.Shutdown();output.join();assert(eos==1);assert(audio.codec_value.played==std::vector<int>{9});assert(audio.codec_value.sizes==std::vector<size_t>{4});
    std::cout<<"PASS EOS includes dequeued decode and final PCM\n";
}
void eos_output() {
    AudioService audio;audio.SetManagedOutput(true);auto id=audio.BeginOutput(1,1);std::atomic<int> eos=0;
    audio.callbacks_.on_output_drained=[&](auto){++eos;};assert(audio.PushPacketToDecodeQueue(packet(id)));audio.DecodeOne();
    Latch output;hooks([&](const char* name){if(std::string(name)=="output")output.pause();});
    std::thread worker([&]{audio.AudioOutputTask();});output.wait();assert(audio.Queued()==0);assert(audio.EndOutput(id));assert(eos==0);
    output.release();{std::unique_lock lock(audio.audio_queue_mutex_);assert(audio.audio_queue_cv_.wait_for(lock,5s,[&]{return audio.managed_current_->active_output==0;}));}
    audio.Shutdown();worker.join();hooks();assert(eos==1);std::cout<<"PASS EOS waits for OutputData return\n";
}
void stale_tasks(bool pcm) {
    AudioService audio;audio.SetManagedOutput(true);auto old=audio.BeginOutput(1,1);std::atomic<int> eos=0;
    audio.callbacks_.on_output_drained=[&](auto){++eos;};assert(audio.PushPacketToDecodeQueue(packet(old,3)));
    if(pcm)audio.DecodeOne();Latch held;hooks([&](const char* name){if(std::string(name)==(pcm?"output_dequeued":"decode_requeue"))held.pause();});
    std::thread worker([&]{if(pcm)audio.AudioOutputTask();else audio.DecodeOne();});held.wait();assert(audio.EndOutput(old));assert(eos==0);
    assert(audio.InterruptOutput(old));assert(audio.Queued()==0);auto next=audio.BeginOutput(2,1);assert(next!=old);
    assert(audio.PushPacketToDecodeQueue(packet(next,5)));held.release();
    if(pcm){audio.Shutdown();worker.join();}else worker.join();hooks();
    assert(audio.Queued()==1);assert(eos==0);assert(audio.codec_value.played.empty());assert(audio.IsCurrentOutput(next));
    std::cout<<"PASS revoked dequeued "<<(pcm?"PCM":"decode")<<" cannot revive across channel epoch1\n";
}
void interrupt_inflight() {
    AudioService audio;audio.SetManagedOutput(true);auto id=audio.BeginOutput(1,1);std::atomic<int> eos=0;
    audio.callbacks_.on_output_drained=[&](auto){++eos;};assert(audio.PushPacketToDecodeQueue(packet(id)));audio.DecodeOne();
    Latch output;hooks([&](const char* name){if(std::string(name)=="output")output.pause();});std::thread worker([&]{audio.AudioOutputTask();});output.wait();
    assert(audio.EndOutput(id));assert(eos==0); // 普通EOS不清队列；后续明确interrupt仍可撤尾音。
    auto interrupt=std::async(std::launch::async,[&]{return audio.InterruptOutput(id);});await_invalid(audio,id);assert(interrupt.wait_for(0ms)!=std::future_status::ready);
    output.release();assert(interrupt.wait_for(5s)==std::future_status::ready);assert(interrupt.get());audio.Shutdown();worker.join();hooks();
    assert(audio.codec_value.played.size()==1&&eos==0);std::cout<<"PASS post-EOS interrupt barrier waits for already entered hardware call and cancels EOS (no zero-ms claim)\n";
}
void decode_error() {
 for(int value:{255,254}) {
    AudioService audio;audio.SetManagedOutput(true);auto id=audio.BeginOutput(1,1);int eos=0;audio.callbacks_.on_output_drained=[&](auto){++eos;};
    assert(audio.PushPacketToDecodeQueue(packet(id,value)));assert(audio.EndOutput(id));audio.DecodeOne();assert(eos==1&&audio.Queued()==0);assert(audio.managed_current_->active_decode==0);
 }
    std::cout<<"PASS failed decode releases its activity and EOS\n";
}
void legacy_reconnect(bool pcm) {
    AudioService audio;audio.SetOutputChannel(1);assert(audio.PushPacketToDecodeQueue(packet({},8,1)));
    if(pcm)audio.DecodeOne();Latch held;hooks([&](const char* name){if(std::string(name)==(pcm?"output_dequeued":"decode_requeue"))held.pause();});
    std::thread worker([&]{if(pcm)audio.AudioOutputTask();else audio.DecodeOne();});held.wait();
    audio.SetOutputChannel(0);audio.SetOutputChannel(2);audio.SetManagedOutput(true);auto next=audio.BeginOutput(2,1);
    assert(audio.PushPacketToDecodeQueue(packet(next,10,2)));held.release();
    if(pcm)audio.Shutdown();worker.join();hooks();assert(audio.Queued()==1&&audio.codec_value.played.empty());assert(audio.IsCurrentOutput(next));
    std::cout<<"PASS legacy untagged "<<(pcm?"PCM":"decode")<<" cannot cross into v1 reconnect\n";
}
void decoder_barrier_and_waiter() {
    AudioService audio;audio.SetManagedOutput(true);auto id=audio.BeginOutput(1,1);assert(audio.PushPacketToDecodeQueue(packet(id)));
    std::atomic<int> decodes=0;hooks([&](const char* name){if(std::string(name)=="decode")++decodes;});
    std::unique_lock decoder(audio.decoder_mutex_);std::thread worker([&]{audio.DecodeOne();});
    {std::unique_lock lock(audio.audio_queue_mutex_);assert(audio.audio_queue_cv_.wait_for(lock,5s,[&]{return audio.managed_current_->active_decode==1;}));}
    auto revoke=std::async(std::launch::async,[&]{return audio.InterruptOutput(id);});await_invalid(audio,id);decoder.unlock();worker.join();assert(revoke.get());hooks();
    assert(decodes==0&&audio.Queued()==0);auto next=audio.BeginOutput(1,2);
    for(int i=0;i<40;++i)assert(audio.PushPacketToDecodeQueue(packet(next)));
    auto waiter=std::async(std::launch::async,[&]{return audio.PushPacketToDecodeQueue(packet(next),true);});assert(audio.InterruptOutput(next));
    assert(waiter.wait_for(5s)==std::future_status::ready&&!waiter.get());
    std::cout<<"PASS decoder-entry barrier and queue-full waiter reject revoked identities\n";
}
void output_error() {
    AudioService audio;audio.SetManagedOutput(true);auto id=audio.BeginOutput(1,1);int eos=0;audio.callbacks_.on_output_drained=[&](auto){++eos;};
    auto pcm=std::make_unique<AudioTask>();pcm->output_identity=id;pcm->pcm={254};audio.audio_playback_queue_.push_back(std::move(pcm));assert(audio.EndOutput(id));
    std::thread worker([&]{audio.AudioOutputTask();});{std::unique_lock lock(audio.audio_queue_mutex_);assert(audio.audio_queue_cv_.wait_for(lock,5s,[&]{return !audio.managed_current_->active_output&&audio.audio_playback_queue_.empty();}));}
    audio.Shutdown();worker.join();assert(eos==1&&audio.managed_current_->active_output==0);std::cout<<"PASS output exception releases own activity\n";
}
void channel_generation() {
    ChannelTransport first;auto old=first.BeginLocalAudioChannel();assert(old&&old->valid);int closed=0;first.on_local_closed_=[&](auto id){assert(id==old->generation);++closed;};
    Latch held;std::thread callback([&]{std::lock_guard lock(old->dispatch_mutex);held.pause();});held.wait();
    auto close=std::async(std::launch::async,[&]{first.EndLocalAudioChannel(old);});assert(close.wait_for(0ms)!=std::future_status::ready);held.release();callback.join();close.get();assert(!old->valid&&closed==1);
    auto next=first.BeginLocalAudioChannel();assert(next->generation>old->generation+1);first.EndLocalAudioChannel(old);assert(next->valid&&closed==1);
    ChannelTransport second;auto third=second.BeginLocalAudioChannel();assert(third->generation>next->generation);
    std::cout<<"PASS channel close/dispatch barrier, tombstone and process-wide non-reused generations\n";
}
void application_controls() {
    Application app;app.OnLocalChannelOpening(1);
    app.Json(1,R"({"type":"hello","features":{"tts_interrupt_v1":true}})");assert(app.tts_interrupt_v1_);
    for(auto value:{"null","true","0","-1","1.5","2147483648","\"1\""}) {
        std::string raw=std::string("{\"type\":\"tts\",\"state\":\"start\",\"output_epoch\":")+value+"}";app.Json(1,raw.c_str());assert(!app.tts_accepting_);
    }
    app.Json(1,R"({"type":"tts","state":"start","output_epoch":1})");auto first=app.tts_output_identity_;
    app.Receive(packet({},11,1));assert(app.audio_service_.Queued()==1);assert(app.GetDeviceState()==kDeviceStateListening);
    app.HandleStateChangedEvent();assert(app.audio_service_.Queued()==1);app.Run();assert(app.GetDeviceState()==kDeviceStateSpeaking&&app.audio_service_.Queued()==1);
    app.audio_service_.EnableVoiceProcessing(true);assert(app.audio_service_.Queued()==1);
    app.Json(1,R"({"type":"tts","state":"start","output_epoch":1})");assert(app.tts_output_identity_==first&&app.audio_service_.Queued()==1);
    app.Json(1,R"({"type":"tts","state":"interrupt","output_epoch":1})");assert(app.audio_service_.Queued()==0&&!app.tts_accepting_);
    auto revoked=app.tts_output_identity_;app.Json(1,R"({"type":"tts","state":"start","output_epoch":1})");assert(app.tts_output_identity_==revoked&&!app.tts_accepting_);
    app.Json(1,R"({"type":"tts","state":"start","output_epoch":2})");auto next=app.tts_output_identity_;app.Receive(packet({},12,1));
    app.OnOutputDrained(first);app.Json(1,R"({"type":"tts","state":"stop","output_epoch":1})");app.Json(1,R"({"type":"tts","state":"interrupt","output_epoch":1})");app.Run();
    assert(app.tts_output_identity_==next&&app.tts_accepting_&&app.audio_service_.Queued()==1&&app.GetDeviceState()==kDeviceStateSpeaking);
    app.AbortSpeaking(kAbortReasonNone);assert(!app.tts_accepting_&&app.audio_service_.Queued()==0&&app.protocol_value.aborts==1);
    app.OnLocalChannelClosed(1);app.OnLocalChannelOpening(2);app.Json(2,R"({"type":"hello","features":{"tts_interrupt_v1":true}})");app.Json(2,R"({"type":"tts","state":"start","output_epoch":1})");
    auto reconnected=app.tts_output_identity_;app.Receive(packet({},13,2));app.Json(1,R"({"type":"hello","features":{}})");app.Json(1,R"({"type":"tts","state":"interrupt","output_epoch":1})");app.OnLocalChannelClosed(1);app.Receive(packet({},99,1));app.OnOutputDrained(next);app.Run();
    assert(app.tts_output_identity_==reconnected&&app.tts_accepting_&&app.tts_interrupt_v1_&&app.audio_service_.Queued()==1&&app.GetDeviceState()==kDeviceStateSpeaking);
    app.Json(2,R"({"type":"tts","state":"stop"})");assert(app.tts_accepting_);app.Json(2,R"({"type":"hello","features":{}})");assert(app.tts_interrupt_v1_);
    std::cout<<"PASS strict epoch, synchronous first frame, no UI reset, duplicate/revoked start, stale UI/EOS/channel, local abort\n";
}
void negotiation() {
    for(auto feature:{"{}",R"({"tts_interrupt_v1":false})",R"({"tts_interrupt_v1":"true"})"}) {
        Application app;app.OnLocalChannelOpening(1);std::string hello=std::string("{\"type\":\"hello\",\"features\":")+feature+"}";app.Json(1,hello.c_str());
        assert(!app.tts_interrupt_v1_&&!app.audio_service_.IsManagedOutput());app.Json(1,R"({"type":"tts","state":"start"})");app.Run();app.Receive(packet({},3,1));assert(app.audio_service_.Queued()==1);
    }
    AudioService audio;audio.SetManagedOutput(true);auto id=audio.BeginOutput(1,1);audio.audio_generation_counter_=UINT64_MAX;assert(audio.InterruptOutput(id));assert(!audio.OutputFenceIdentity().tagged());assert(!audio.BeginOutput(1,2).tagged());
    std::cout<<"PASS old server/no ack/false/string legacy and local generation exhaustion fail closed\n";
}
void eos_callback_then_interrupt() {
    Application app;app.OnLocalChannelOpening(1);app.Json(1,R"({"type":"hello","features":{"tts_interrupt_v1":true}})");
    app.Json(1,R"({"type":"tts","state":"start","output_epoch":1})");app.Run();
    app.Json(1,R"({"type":"tts","state":"stop","output_epoch":1})");assert(app.tasks.size()==1&&!app.tts_accepting_);
    app.Json(1,R"({"type":"tts","state":"interrupt","output_epoch":1})");assert(app.tts_revoked_);
    app.Json(1,R"({"type":"tts","state":"start","output_epoch":2})");auto next=app.tts_output_identity_;app.Receive(packet({},17,1));app.Run();
    assert(app.tts_output_identity_==next&&app.tts_accepting_&&app.audio_service_.Queued()==1&&app.GetDeviceState()==kDeviceStateSpeaking);
    app.audio_service_.audio_generation_counter_=UINT64_MAX;app.Json(1,R"({"type":"tts","state":"interrupt","output_epoch":2})");app.Run();
    assert(!app.tts_accepting_&&app.protocol_value.closed==1);
    std::cout<<"PASS queued EOS callback -> explicit same-epoch interrupt -> new start preserves new first frame; exhaustion closes channel\n";
}
void superseded_pending_ui() {
    Application app;app.OnLocalChannelOpening(1);app.Json(1,R"({"type":"hello","features":{"tts_interrupt_v1":true}})");
    app.Json(1,R"({"type":"tts","state":"start","output_epoch":1})");auto old=app.tts_output_identity_;app.Receive(packet({},4,1));
    app.Json(1,R"({"type":"tts","state":"start","output_epoch":2})");auto next=app.tts_output_identity_;app.Receive(packet({},6,1));
    assert(app.audio_service_.Queued()==1);app.OnOutputDrained(old);app.Run();
    assert(app.tts_output_identity_==next&&app.tts_accepting_&&app.audio_service_.Queued()==1&&app.GetDeviceState()==kDeviceStateSpeaking);
    std::cout<<"PASS delayed old Speaking and EOS cannot clear a superseding start's first frame\n";
}
