struct Latch {
    std::mutex mutex; std::condition_variable cv; bool entered=false, released=false;
    void pause() { std::unique_lock lock(mutex); entered=true; cv.notify_all(); cv.wait(lock,[&]{return released;}); }
    void wait() { std::unique_lock lock(mutex); assert(cv.wait_for(lock,5s,[&]{return entered;})); }
    void release() { std::lock_guard lock(mutex); released=true; cv.notify_all(); }
};
std::mutex hooks_mutex;
std::function<void(const char*)> hook_fn;
void hook(const char* name) { std::function<void(const char*)> fn; { std::lock_guard lock(hooks_mutex); fn=hook_fn; } if(fn) fn(name); }
void hooks(std::function<void(const char*)> fn={}) { std::lock_guard lock(hooks_mutex); hook_fn=std::move(fn); }
