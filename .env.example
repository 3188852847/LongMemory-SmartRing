# 本文件只保存变量名和安全示例，不得填写真实密钥。
LONGMEMORY_DATABASE_PATH=data/databases/longmemory.db
LONGMEMORY_LOG_PATH=data/logs/events.jsonl

# 默认 Fake；校园网验证时在本地 .env 中改为 openai_compatible。
LONGMEMORY_LLM_PROVIDER=fake
LONGMEMORY_LLM_BASE_URL=
LONGMEMORY_LLM_API_KEY=
LONGMEMORY_LLM_MODEL=
LONGMEMORY_LLM_TIMEOUT_SECONDS=30
LONGMEMORY_LLM_MAX_TOKENS=512
# 仅在确认明文传输风险后允许 HTTP；校园网不自动等于加密。
LONGMEMORY_LLM_ALLOW_HTTP=false
